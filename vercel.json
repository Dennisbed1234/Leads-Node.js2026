{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "functions": {
    "src/server.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "env": {
    "PLAYWRIGHT_USE_SPARTICUZ": "1",
    "DB_DISABLED": "true",
    "SCRAPE_TIME_BUDGET_MS": "45000"
  }
}
